{
  "name": "@nexus-chat/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "PERSISTENCE=postgres DATABASE_URL=${DATABASE_URL:-postgres://nexus:nexus@localhost:5432/nexus_chat} tsx src/db/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.15",
    "@hono/zod-validator": "^0.4.2",
    "@nexus-chat/shared": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "@paralleldrive/cuid2": "^2.2.2",
    "@types/jsonwebtoken": "^9.0.7",
    "bullmq": "^5.34.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.34",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2"
  }
}
