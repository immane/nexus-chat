{
  "name": "@nexus-chat/tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "nexus": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "smoke": "tsx src/index.ts login -e alice@t.local -p test1234abcd && tsx src/index.ts bot-smoke && tsx src/index.ts e2e-smoke"
  },
  "dependencies": {
    "@nexus-chat/shared": "workspace:*",
    "@nexus-chat/signal": "workspace:*",
    "commander": "^12.1.0",
    "ink": "^6.8.0",
    "react": "^19.0.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "tsx": "^4.19.2"
  }
}
