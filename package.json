{
  "name": "nexus-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "coverage": "vitest run --coverage",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @nexus-chat/server db:generate",
    "db:migrate": "pnpm --filter @nexus-chat/server db:migrate",
    "db:seed": "pnpm --filter @nexus-chat/server db:seed",
    "smoke:tui": "pnpm --filter @nexus-chat/tui smoke",
    "smoke:tui:ci": "bash scripts/ci-tui-smoke.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
