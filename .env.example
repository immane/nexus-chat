NODE_ENV=development
# HOST — interface to bind to: "127.0.0.1" (default local dev) | "0.0.0.0" (Docker/LAN) | "::" (all IPv6) | domain/IP
HOST=127.0.0.1
PORT=4000
# API_PUBLIC_BASE — externally reachable HTTP base that the server embeds in dev upload/download URLs.
# Keep this aligned with VITE_API_BASE for local development.
API_PUBLIC_BASE=http://127.0.0.1:4000
# WEB_ORIGIN — CORS allowed origin for HTTP and WebSocket (protocol + hostname match).
#   "http://localhost"           — default dev (allows any localhost port)
#   "http://192.168.x.x:4000"    — LAN access
#   "https://your-domain.com"    — production
#   "*"                          — temporary local/LAN testing only; allows all origins
WEB_ORIGIN=http://localhost
DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus_chat
# PERSISTENCE defaults to memory in development and test. Production requires postgres.
PERSISTENCE=memory
# Local-only convenience for applying migrations at boot. Production must remain false.
DB_MIGRATE_ON_BOOT=false
REDIS_URL=redis://localhost:6379
SESSION_STORE=memory
JWT_ISSUER=nexus-chat
JWT_AUDIENCE=nexus-chat-clients
JWT_PRIVATE_KEY_PEM=""
JWT_PUBLIC_KEY_PEM=""
JWT_KID=local-dev
LOG_LEVEL=info
# VITE_API_BASE — backend URL the web client connects to.
#   "http://127.0.0.1:4000"       — default (same machine, avoids localhost IPv4/IPv6 split)
#   "http://192.168.x.x:4000"     — LAN access
#   "https://api.your-domain.com" — production
VITE_API_BASE=http://127.0.0.1:4000
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=nexus-chat-local
# P2P / WebRTC
NEXUS_STUN_SERVERS=stun:stun.l.google.com:19302
NEXUS_TURN_SERVERS=
NEXUS_TURN_USERNAME=
NEXUS_TURN_CREDENTIAL=
NEXUS_P2P_CONNECTION_TIMEOUT_MS=5000
NEXUS_P2P_RELAY_COOLDOWN_MS=30000
